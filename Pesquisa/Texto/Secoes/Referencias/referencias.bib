@article{shmuel1987,
title = {Multi-product pricing for electric power},
journal = {Energy Economics},
volume = {9},
number = {2},
pages = {104-114},
year = {1987},
issn = {0140-9883},
doi = {https://doi.org/10.1016/0140-9883(87)90013-2},
url = {https://www.sciencedirect.com/science/article/pii/0140988387900132},
author = {Shmuel S. Oren and Stephen A. Smith and Robert B. Wilson},
keywords = {Electric power, Pricing, Modelling},
abstract = {This paper describes methods for determining the prices for a discrete set of interrelated products offered by a single supplier. Each product has a fixed marginal rate per unit, the demand for each product depends upon the price levels of all the products and the supplier's cost function depends upon the demands for all the products. For specific demand function forms, methods are described for determining the prices that maximize a weighted sum of net revenue and consumer surplus.},
note = {DOI: 10.1016/0140-9883(87)90013-2}
}

